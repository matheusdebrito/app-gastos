{
  "expo": {
    "name": "App Gastos",
    "slug": "app-gastos",
    "scheme": "appgastos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.appgastos.local"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
